# generated video projects (data output, not source) — can be hundreds of MB
out/

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# macOS
.DS_Store

# secrets — never commit
.env
credentials.json
token.json
*.key
.api_key
.agnes_key
.agnes_keys
.agentrouter_key
.libertai_key

# runtime state
jobs.json

# internal working notes (kept local, not published)
PROGRESS.md
PROMO_SUBMISSIONS.md

# references/: publish only the English .md docs; keep local reference
# material (videos, images, non-English notes) out of the repo
references/*
!references/*.md
references/PIPELINE_PLAYBOOK.md

# Google OAuth secrets
client_secret.json
.youtube_token.json
client_secret*.json
